{
  "name": "amm-approval-api",
  "version": "1.0.0",
  "description": "Serverless purchase approval API for AWS SAM",
  "scripts": {
    "build": "sam build --template-file template.yaml",
    "test": "vitest --configLoader runner run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest --configLoader runner",
    "coverage": "vitest --configLoader runner run --coverage"
  },
  "keywords": ["aws-sam", "serverless", "dynamodb", "lambda"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1111.0",
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "private": true
}
